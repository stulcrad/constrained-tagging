#!/bin/bash
#SBATCH --partition=gpu
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gres=gpu:1
#SBATCH --mem=64G
#SBATCH --time=24:00:00
#SBATCH --job-name=NER_xgrammar_baseline_eval
#SBATCH --output=/path/to/constrained-tagging/logs/scripts/evaluationNER_xgrammar_baseline_%j.out
#SBATCH --error=/path/to/constrained-tagging/logs/scripts/evaluationNER_xgrammar_baseline_%j.err

cd ~/constrained-tagging
source init_environment_python.sh


echo "Starting NER XGrammar Context Based Baseline evaluation on node $(hostname -s)"

BATCH_SIZE="${1:-1}" # default to batch size of 1
echo "Using batch size: ${BATCH_SIZE}"
python scripts/NER/evaluationNER_xgrammar_baseline.py "${BATCH_SIZE}"
